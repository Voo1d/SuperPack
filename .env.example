# Скопируйте в .env (файл .env в Git не попадает). Реальные токены и секреты сюда не записывайте.

# --- Сервер ---
PORT=8000
DATABASE_URL=postgres://superpack:superpack@localhost:5432/superpack
# local | production. В production DEV_AUTH запрещён (сервер откажется стартовать).
NODE_ENV=development
APP_TIMEZONE=Asia/Tashkent

# --- Telegram ---
# Токен бота, которому принадлежит Mini App: им проверяется подпись initData. Выдаёт @BotFather.
TELEGRAM_BOT_TOKEN=
# Telegram ID первого администратора (можно несколько через запятую). Всегда активны с ролью admin.
ADMIN_TELEGRAM_IDS=
# Срок действия initData в секундах (по умолчанию сутки).
INIT_DATA_MAX_AGE_SECONDS=86400

# --- Только локальная разработка без Telegram ---
# При DEV_AUTH=true запросы без initData выполняются от одного пользователя DEV_TELEGRAM_ID (задаётся здесь, клиент его выбрать не может).
# Токен бота при этом не нужен. Не включайте на сервере.
DEV_AUTH=false
DEV_TELEGRAM_ID=
DEV_USER_NAME="Dev User"

# --- Тесты (необязательно) ---
# TEST_DATABASE_URL=postgres://superpack:superpack@localhost:5432/superpack_test
